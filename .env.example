# Semay – Umgebungsvariablen (Vorlage). Echte Werte gehören NIE in dieses Repository.
#
# Wichtig: Die App (app/) braucht KEINE geheimen Schlüssel. Sie spricht Supabase nur mit der öffentlichen Adresse
# und dem öffentlichen Lese-Schlüssel an (stehen bewusst in app/src/lib/supabase.ts). Lesen ist für alle erlaubt,
# Schreiben prüft die Datenbank (nur der Betreiber, siehe private.is_owner()).
#
# Geheimnisse leben ausschließlich serverseitig:
#   - Supabase → Project Settings → Edge Functions → Secrets (für die Edge Functions)
#   - Tabelle private.settings in der Datenbank (für die Zeitpläne, die die Edge Functions aufrufen)

# ---------------------------------------------------------------- Öffentlich (App, Web)
# Adresse des Supabase-Projekts (öffentlich)
SUPABASE_URL=https://mkcaioabbzccawjmtndw.supabase.co
# Öffentlicher Lese-Schlüssel („publishable key“). Darf in der App stehen; erlaubt nur, was die Zeilenrechte zulassen.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# ---------------------------------------------------------------- Edge Functions (Supabase Secrets)
# Werden von Supabase automatisch gesetzt – nicht selbst eintragen:
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY

# Kontaktadresse für MyMemory (maschinelle Übersetzung der Schlagzeilen). Mit Adresse 50.000 statt 5.000 Zeichen pro Tag.
# Ohne Eintrag nutzt die Funktion translate info@beles.app.
MYMEMORY_EMAIL=info@beles.app

# ---------------------------------------------------------------- In der Datenbank (private.settings), nicht als Variable
# ingest_key: interner Schlüssel, mit dem die Zeitpläne (pg_cron) die Edge Functions ingest, signals, satellite,
# translate und notify aufrufen (Header x-ingest-key). Wird beim Einrichten zufällig erzeugt (001_init.sql).

# ---------------------------------------------------------------- Noch nicht eingerichtet (Zugang fehlt)
# ReliefWeb (UN OCHA): seit November 2025 nur mit vorab genehmigtem App-Namen.
# Antrag: https://apidoc.reliefweb.int/parameters#appname – danach hier eintragen und die Quelle in sources anlegen.
# RELIEFWEB_APPNAME=
#
# ACLED (Konfliktereignisse): Konto und Zugangsschlüssel nötig, Nutzungsbedingungen beachten (Weitergabe eingeschränkt).
# https://acleddata.com/ – Registrierung durch den Betreiber.
# ACLED_EMAIL=
# ACLED_KEY=
#
# GDELT braucht keinen Schlüssel, lehnt aber Abfragen von der gemeinsam genutzten Supabase-Serveradresse ab (HTTP 429).
# Abhilfe wäre ein eigener Abrufserver mit fester Adresse; derzeit abgeschaltet.
#
# NASA FIRMS, USGS, IODA, UKMTO und Microsoft Planetary Computer (Sentinel-2) brauchen keinen Schlüssel.
#
# Push-Benachrichtigungen in der Handy-App: Expo-Projekt-ID nach `eas init` (siehe app/STORE.md), kein Geheimnis.
